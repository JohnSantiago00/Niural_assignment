# -----------------------------------------------------------------------------
# Core app
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Required for app boot, migrations, seed data, auth, and resume storage.
# SUPABASE_DB_URL is the direct Postgres connection string used by npm run db:setup.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://rrxjejxzcmdihwexmwzt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rrxjejxzcmdihwexmwzt.supabase.co:5432/postgres
SUPABASE_RESUME_BUCKET=candidate-resumes

# Optional seed helper: adds this email to public.admin_users during npm run db:setup/db:seed.
# You still need to create the matching Supabase Auth user in your project.
DEMO_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Gemini
# Optional AI integration. Deterministic fallbacks keep demo flows moving if quota is exhausted.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Google Calendar
# Optional scheduling integration.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_INTERVIEWER_NAME=Hiring Team
GOOGLE_CALENDAR_INTERVIEWER_EMAIL=
GOOGLE_IMPERSONATED_USER_EMAIL=
GOOGLE_TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# Resend
# Optional transactional email integration.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hiring Team <hiring@example.com>
OFFER_ALERT_EMAIL=

# -----------------------------------------------------------------------------
# Slack
# Optional real lookup/messaging + invite-link onboarding flow.
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_INVITE_URL=
SLACK_HR_CHANNEL_ID=
SLACK_ONBOARDING_CHANNEL_ID=
SLACK_ONBOARDING_RESOURCE_LINKS=

# Optional Slack admin invite support: only needed if your workspace/app supports admin invites.
SLACK_ADMIN_TOKEN=
SLACK_TEAM_ID=
SLACK_INVITE_CHANNEL_IDS=
